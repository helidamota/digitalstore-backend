{
    "watch": [
        "src"
    ],
    "ext": "ts,js",
    "ignore": [
        "src/**/*.spec.ts",
        "src/**/*.test.ts"
    ],
    "exec": "ts-node-dev --respawn --transpile-only src/server.ts",
    "nodeArgs": [
        "--require",
        "ts-node/register",
        "--require",
        "tsconfig-paths/register"
    ]
}